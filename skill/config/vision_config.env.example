# ============================================================
# DeepSeek Vision 配置文件模板（Image Vision Skill）
#
# 使用方法：复制本文件为 vision_config.env，然后填写真实配置
#
# 注意：
#   - 全项目唯一的 API 配置位置就是 vision_config.env，
#     不要在其他文件（SKILL.md / vision.py / api_client.py / README.md）里找配置
#   - 用 VS Code 直接编辑，保存即生效，无需重启 Claude Code
#   - vision_config.env 已被 .gitignore 忽略，不会上传 GitHub
#   - GitHub 仓库只保留本模板（不含真实 API Key）
# ============================================================

# 【必填】你的 DeepSeek API Key
# 获取地址：https://platform.deepseek.com/api_keys
VISION_API_KEY=your_api_key_here

# 【可选】API 地址，默认官方地址，一般不用改
VISION_API_BASE_URL=https://api.deepseek.com

# 【可选】视觉模型名称（DeepSeek 官方视觉模型）
VISION_MODEL=deepseek-v4-flash-vision-exp

# 【可选】图片处理精度（官方 detail 参数）：
#   auto     - 自动，官方推荐（当前等效 original）
#   low      - 缩放到 512×512，速度最快、最省 token
#   high     - 保留原图精度
#   original - 保留原图精度（与 high 相同）
VISION_IMAGE_DETAIL=auto

# 【可选】单次 API 请求超时时间（秒），大图可适当调大
VISION_TIMEOUT_SECONDS=120
